{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "level",
    "surrogate_pass",
    "failed_assertions",
    "failure_types",
    "root_cause",
    "skill_gap",
    "actionable_revision",
    "confidence"
  ],
  "properties": {
    "sample_id": {"type": "string"},
    "level": {"type": "integer", "enum": [1, 2, 3]},
    "surrogate_pass": {"type": "boolean"},
    "failed_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion", "observed", "expected_behavior"],
        "properties": {
          "assertion": {"type": "string"},
          "observed": {"type": "string"},
          "expected_behavior": {"type": "string"}
        }
      }
    },
    "failure_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "FORMAT_ERROR",
          "INSTRUCTION_MISREAD",
          "TEMPORAL_REASONING_ERROR",
          "NUMERIC_REASONING_ERROR",
          "EVIDENCE_MISUSE",
          "UNSUPPORTED_INFERENCE",
          "MISSING_CONSTRAINT",
          "OVER_GENERALIZATION",
          "TASK_STRATEGY_ERROR",
          "UNKNOWN"
        ]
      }
    },
    "root_cause": {"type": "string"},
    "skill_gap": {"type": "string"},
    "actionable_revision": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
  }
}
